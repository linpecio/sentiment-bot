# Get a token from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs that receive automatic market-open reports.
# Send /start to the bot to see your chat ID.
REPORT_CHAT_IDS=
# Data provider: "stub" (fake data, no IBKR needed) or "ibkr" (needs TWS/IB Gateway).
DATA_PROVIDER=stub
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=17
# Free API news feeds; add +BZ if you subscribe to Benzinga.
IBKR_NEWS_PROVIDERS=BRFG+BRFUPDN+DJNL
# 1 = live market data (needs subscriptions), 3 = delayed (free, 15-20 min late).
IBKR_MARKET_DATA_TYPE=1
# How far back to look for headlines, in hours.
NEWS_LOOKBACK_HOURS=24

# Sentiment scorer: "lexicon" (keyword placeholder) or "claude".
SCORER=lexicon
# Needed when SCORER=claude. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used to score headlines. claude-haiku-5-5 is much cheaper.
SENTIMENT_MODEL=claude-opus-5-5
SENTIMENT_EFFORT=low
